{
  "name": "silaut",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "node scripts/preview.cjs",
    "build": "npm run build --workspace frontend",
    "start": "node backend/server.js",
    "migrate": "node backend/migrate.js",
    "seed": "node backend/import-menu.js",
    "test": "node --test tests/normalize.test.cjs",
    "test:integration": "node --test --test-concurrency=1 tests/integration.test.cjs tests/v2.test.cjs",
    "menu:import": "node backend/import-menu.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "playwright": "1.65.1"
  }
}
