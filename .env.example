# Run bash scripts/configure.sh to generate a private .env.
POSTGRES_PASSWORD=REPLACE_WITH_DATABASE_OWNER_PASSWORD
POS_APP_PASSWORD=REPLACE_WITH_RUNTIME_DATABASE_PASSWORD
BASIC_AUTH_USER=REPLACE_WITH_DEMO_USERNAME
# Keep real bcrypt hashes single-quoted so Compose preserves dollar signs.
BASIC_AUTH_HASH='REPLACE_WITH_CADDY_BCRYPT_HASH'
DEPLOY_MODE=tunnel
SITE_HOST=pos.example.com
ACME_EMAIL=REPLACE_WITH_CERTIFICATE_CONTACT
CACHE_MODE=ttl-fenced
CACHE_TTL_SECONDS=10
